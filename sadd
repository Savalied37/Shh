        local player = game:GetService("Players").LocalPlayer
        local gui = player:WaitForChild("PlayerGui")
        return gui:WaitForChild("Inventory")
            :WaitForChild("LayerContent")
            :WaitForChild("InventoryScreen")
            :WaitForChild("RightPanel")
            :WaitForChild("PanelContainer")
            :WaitForChild("InventorySwapPanel")
            :WaitForChild("PanelContainer")
            :WaitForChild("Panel3")
            :WaitForChild("Crate")
            :WaitForChild("LabeledSlotGrid")
            :WaitForChild("SlotGrid")
    end)
    return success and slotGrid or nil
end

-- ===== INVENTORY (SlotGrid) =====
local function GetInventorySlotGrid()
    local success, slotGrid = pcall(function()
        local player = game:GetService("Players").LocalPlayer
        local gui = player:WaitForChild("PlayerGui")
        return gui:WaitForChild("Inventory")
            :WaitForChild("LayerContent")
            :WaitForChild("InventoryScreen")
