-- ===== СКАНЕР СУНДУКА =====
local function ScanChestItems()
    local slotGrid = GetChestSlotGrid()
    ChestItemsData = {}
    
    if not slotGrid then
        Rayfield:Notify({
            Title = "Ошибка",
            Content = "Chest SlotGrid не найден!",
            Duration = 3,
        })
        return {}
    end
    
    local results = {}
    
    for _, slot in ipairs(slotGrid:GetChildren()) do
        local slotNumber = slot.Name:match("^Slot(%d+)$")
        
        if slotNumber then
            local item = slot:FindFirstChild("Item")
            if item then
                local itemModel = item:FindFirstChild("ItemModel")
                if itemModel then
                    local iconViewport = itemModel:FindFirstChild("ItemIconViewport")
                    if iconViewport then
                        local itemName = nil
                        
                        for _, child in ipairs(iconViewport:GetChildren()) do
                            if not child:IsA("Camera") and child.Name ~= "WorldModel" then
                                itemName = child.Name
                                break
                            end
                        end
                        
                        if itemName then
                            ChestItemsData[tonumber(slotNumber)] = itemName
                            table.insert(results, "Slot " .. slotNumber .. " - " .. itemName)
                        end
                    end
                end
            end
        end
    end
    
    table.sort(results, function(a, b)
        local numA = tonumber(a:match("Slot (%d+)"))
        local numB = tonumber(b:match("Slot (%d+)"))
        return numA < numB
    end)
    
    return results
end

-- ===== СКАНЕР ИНВЕНТАРЯ (пустые слоты) =====
local function ScanEmptyInventorySlots()
    local slotGrid = GetInventorySlotGrid()
    EmptyInventorySlots = {}
    
    if not slotGrid then
        Rayfield:Notify({
            Title = "Ошибка",
            Content = "Inventory SlotGrid не найден!",
            Duration = 3,
        })
        return {}
    end
    
    local results = {}
    
    for _, slot in ipairs(slotGrid:GetChildren()) do
        local slotNumber = slot.Name:match("^Slot(%d+)$")
        
        if slotNumber then
            local nameLabel = slot:FindFirstChild("NameLabel")
            
            if nameLabel then
                local text = nameLabel.Text
                
                -- Проверяем пустой ли слот
                if text == "" or text == nil then
                    table.insert(EmptyInventorySlots, tonumber(slotNumber))
                    table.insert(results, "Slot " .. slotNumber .. " (Пусто)")
                end
            end
        end
    end
    
    table.sort(results, function(a, b)
        local numA = tonumber(a:match("Slot (%d+)"))
        local numB = tonumber(b:match("Slot (%d+)"))
        return numA < numB
    end)
    
    return results
end

-- ===== MOVE ITEM =====
local function MoveItem(chestIndex, inventoryIndex)
    local remote = GetRemote()
    
    if not remote then
        Rayfield:Notify({
            Title = "Ошибка",
            Content = "Не удалось найти Remote путь!",
            Duration = 3,
        })
        return
    end
    
    local args = {
        { index = chestIndex, container = "external" },
        { index = inventoryIndex, container = "inventory" }
    }
    
    local success, err = pcall(function()
        remote:FireServer(table.unpack(args))
    end)
    
    if success then
        Rayfield:Notify({
            Title = "Успех",
            Content = "Перемещено: Chest[" .. chestIndex .. "] -> Inv[" .. inventoryIndex .. "]",
            Duration = 2,
        })
    else
        Rayfield:Notify({
            Title = "Ошибка",
            Content = tostring(err),
            Duration = 3,
        })
    end
end

