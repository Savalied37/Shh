----------------------------------------------------------------
-- Main render loop
----------------------------------------------------------------
local lastEspUpdate, lastEspCamPos = 0, camera.CFrame.Position
local fpsElapsed, fpsFrames, currentFps = 0, 0, 60

renderConnection = RunService.RenderStepped:Connect(function(dt)
	if settings.unloaded then return end
	local now = clockNow()

	fpsElapsed += dt; fpsFrames += 1
	if fpsElapsed >= 0.5 then
		currentFps = mathFloor(fpsFrames / fpsElapsed + 0.5)
		fpsElapsed, fpsFrames = 0, 0
	end

	-- Clean dead NPC targets
	for npc, data in pairs(npcTargets) do
		if not npc.Parent
			or (data.hum and data.hum.Health <= 0)
			or (data.root and not data.root.Parent)
			or (data.head and not data.head.Parent) then
			removeNpcTarget(npc)
		end
	end

	-- Clean dead player targets
	for plr, data in pairs(playerTargets) do
		local c = plr.Character
		if not c
			or (data.hum and data.hum.Health <= 0)
			or (data.root and not data.root.Parent)
			or (data.head and not data.head.Parent) then
			if not c then removePlayerTarget(plr) end
		end
		if c and data.char ~= c then addPlayerTarget(plr, c) end
	end

	-- Aim
	if settings.silentAim and now - lastAimUpdate > aimUpdateInterval then
		updateAimTarget()
	end

	-- ESP
	local camPos = camera.CFrame.Position
	if settings.wallEsp and (now - lastEspUpdate > 0.12 or (camPos - lastEspCamPos).Magnitude > 1.5) then
		lastEspUpdate = now
		lastEspCamPos = camPos
		updateEspVisibility(camPos)
	end

	-- FOV circle
	if fovCircle then
		pcall(function()
			fovCircle.Visible = settings.silentAim and settings.showFov and not settings.unloaded
			fovCircle.Position = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
			fovCircle.Radius = settings.fovRadius
			fovCircle.Color = settings.wallbang and Color3.fromRGB(255,80,80) or Color3.fromRGB(0,210,255)
		end)
	end
end)

