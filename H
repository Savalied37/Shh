local function createHeadBox(part)
	if not part or not part.Parent then return nil end
	local existing = part:FindFirstChild("WallBox")
	if existing then return existing end
	local b = Instance.new("BoxHandleAdornment")
	b.Name = "WallBox"
	b.Size = part.Size + Vector3.new(0.6,0.6,0.6)
	b.Adornee = part
	b.AlwaysOnTop = true
	b.ZIndex = 10
	b.Color3 = Color3.fromRGB(255,60,60)
	b.Transparency = 0.35
	b.Parent = part
	return b
end

local function createDistanceTag(part)
	if not part or not part.Parent then return nil end
	local existing = part:FindFirstChild("DistTag")
	if existing then return existing end
	local bg = Instance.new("BillboardGui")
	bg.Name = "DistTag"
	bg.Adornee = part
	bg.Size = UDim2.new(0,60,0,18)
	bg.StudsOffset = Vector3.new(0,2.2,0)
	bg.AlwaysOnTop = true
	bg.Parent = part
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1,0,1,0)
	tl.BackgroundTransparency = 1
	tl.Text = ""
	tl.Font = Enum.Font.GothamBold
	tl.TextSize = 11
	tl.TextColor3 = Color3.new(1,1,1)
	tl.TextStrokeTransparency = 0
	tl.Parent = bg
	return bg
end

local function attachTargetEsp(model, data)
	if data.head and data.head.Parent then
		local box = createHeadBox(data.head)
		if box then
			headBoxes[data.head] = box
			headOwners[data.head] = model
		end
		local tag = createDistanceTag(data.head)
		if tag then distanceTags[data.head] = tag end
	end
end

local function removeTargetEsp(data)
	if data.head then
		pcall(function()
			local b = data.head:FindFirstChild("WallBox")
			if b then b:Destroy() end
			local t = data.head:FindFirstChild("DistTag")
			if t then t:Destroy() end
		end)
		headBoxes[data.head] = nil
		headOwners[data.head] = nil
		distanceTags[data.head] = nil
	end
end

local function clearAllEsp()
	for _,b in pairs(headBoxes) do pcall(function() if b and b.Parent then b:Destroy() end end) end
	for _,b in pairs(torsoBoxes) do pcall(function() if b and b.Parent then b:Destroy() end end) end
	for _,t in pairs(distanceTags) do pcall(function() if t and t.Parent then t:Destroy() end end) end
	table.clear(headBoxes); table.clear(headOwners); table.clear(torsoBoxes); table.clear(distanceTags)
end

