local function findNilModule(name)
	local getter = getnilinstances or get_nil_instances
	if not getter then return nil end
	for _, inst in next, getter() do
		if inst.Name == name and inst:IsA("ModuleScript") then
			return inst
		end
	end
	return nil
end

