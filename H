local function findNpcHead(npc)
	return npc:FindFirstChild("Head") or npc:FindFirstChild("FakeHead")
end

local function findNpcRoot(npc)
	return npc:FindFirstChild("Root")
		or npc:FindFirstChild("UpperTorso")
		or npc:FindFirstChild("LowerTorso")
end

local function isValidNpc(npc)
	if settings.unloaded then return false end
	if not npc or not npc:IsA("Model") then return false end
	if npc.Name ~= "Male" then return false end
	if isExcludedModel(npc) then return false end
	local localChar = localPlayer.Character
	if localChar then
		if npc == localChar then return false end
		local ok, desc = pcall(function() return npc:IsDescendantOf(localChar) end)
		if ok and desc then return false end
	end
	local hum = npc:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return false end
	local head, root = findNpcHead(npc), findNpcRoot(npc)
	if not head or not root then return false end
	if not head:IsA("BasePart") or not root:IsA("BasePart") then return false end
	return true
end

