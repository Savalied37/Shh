local recoilState = { on = false, orig = {} }

local function enableNoRecoil()
	if recoilState.on then return end
	recoilState.on = true
	local scr = findNilModule("Recoiler")
	if scr then
		local ok, mod = pcall(require, scr)
		if ok and type(mod) == "table" and mod.Impulse then
			recoilState.orig.Impulse = mod.Impulse
			mod.Impulse = function() return nil end
			recoilState.recoiler = mod
		end
	end
end

local function restoreRecoil()
	if not recoilState.on then return end
	recoilState.on = false
	pcall(function()
		if recoilState.recoiler then
			recoilState.recoiler.Impulse = recoilState.orig.Impulse
		end
	end)
	table.clear(recoilState.orig)
	recoilState.recoiler = nil
end

----------------------------------------------------------------
-- No Spread
----------------------------------------------------------------
local spreadState = { on = false, wrapped = {}, origNew = nil, newMod = nil }
local spreadFieldPaths = {
	{"_firearm","Tune","Barrel_Spread"},
	{"Tune","Barrel_Spread"},
	{"_firearm","Tune","Spread"},
	{"Tune","Spread"},
}

local function resolveFieldParent(root, path)
	local cur = root
	for i = 1, #path - 1 do
		if type(cur) ~= "table" then return nil end
		local ok, child = pcall(function() return cur[path[i]] end)
		if not ok or type(child) ~= "table" then return nil end
		cur = child
	end
	if type(cur) ~= "table" then return nil end
	return cur, path[#path]
end

local function isFirearmInventory(t)
	local ok1, has = pcall(function()
		return type(t.Tune)=="table" or (type(t._firearm)=="table" and type(t._firearm.Tune)=="table")
	end)
	if not ok1 or not has then return false end
	local ok2, d = pcall(function() return type(t.Discharge)=="function" end)
	return ok2 and d
end

local function wrapDischarge(inv)
	if spreadState.wrapped[inv] then return true end
	local orig; pcall(function() orig = inv.Discharge end)
	if type(orig) ~= "function" then return false end
	spreadState.wrapped[inv] = orig

	inv.Discharge = function(self, ...)
		local me = type(self)=="table" and self or inv
		local saved
		if spreadState.on then
			for _, p in ipairs(spreadFieldPaths) do
				local par, key = resolveFieldParent(me, p)
				if par then
					local ok2, v = pcall(function() return par[key] end)
					if ok2 and type(v)=="number" and v ~= 0 then
						saved = saved or {}
						tableInsert(saved, {par, key, v})
						pcall(function() par[key] = 0 end)
					end
				end
			end
		end
		local res = tablePack(pcall(orig, me, ...))
		if saved then
			for _, e in ipairs(saved) do pcall(function() e[1][e[2]] = e[3] end) end
		end
		if res[1] then return (tableUnpack or unpack)(res, 2, res.n)
		else error(res[2], 0) end
	end
	return true
end

local function hookInventoryConstructor()
	if spreadState.newMod then return true end
	local scr = findNilModule("FirearmInventory")
	if not scr then return false end
	local ok, mod = pcall(require, scr)
	if not ok or type(mod)~="table" or type(mod.new)~="function" then return false end
	spreadState.newMod = mod
	spreadState.origNew = mod.new
	local origNew = mod.new
	mod.new = function(self, ...)
		local inv = origNew(self, ...)
		if type(inv)=="table" then pcall(wrapDischarge, inv) end
		return inv
	end
	return true
end

local scannedFirearms = false
local function scanAndWrapFirearms()
	if scannedFirearms then return 0 end
	scannedFirearms = true
	local count = 0
	local getgc_ = getgc
	if getgc_ then
		local ok, objs = pcall(getgc_)
		if ok and type(objs)=="table" then
			for _, o in ipairs(objs) do
				if type(o)=="table" and not spreadState.wrapped[o] then
					local valid = false
					pcall(function() valid = isFirearmInventory(o) end)
					if valid then
						local w = false
						pcall(function() w = wrapDischarge(o) end)
						if w then count += 1 end
					end
				end
			end
		end
	end
	return count
end

local function restoreSpreadHooks()
	spreadState.on = false
	scannedFirearms = false
	for inv, orig in pairs(spreadState.wrapped) do
		pcall(function() inv.Discharge = orig end)
	end
	table.clear(spreadState.wrapped)
	if spreadState.newMod and spreadState.origNew then
		pcall(function() spreadState.newMod.new = spreadState.origNew end)
	end
	spreadState.newMod, spreadState.origNew = nil, nil
end

