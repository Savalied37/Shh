local function removePlayerTarget(plr)
	local data = playerTargets[plr]
	playerTargets[plr] = nil
	if data then
		removeTargetEsp(data)
		if data.diedConn then pcall(function() data.diedConn:Disconnect() end) end
		if selectedAimPart and (selectedAimPart == data.head or selectedAimPart == data.root) then
			selectedAimPart = nil
		end
	end
end

local function addPlayerTarget(plr, char)
	if settings.unloaded or not char or not char.Parent then return end
	if plr == localPlayer then return end
	local root, head = findPlayerParts(char)
	if not root or not head then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return end

	removePlayerTarget(plr)
	local data = { char = char, root = root, head = head, hum = hum, player = plr }
	playerTargets[plr] = data

	if settings.wallEsp and settings.mode == "PVP" then
		attachTargetEsp(char, data)
	end

	if hum then
		data.diedConn = trackConnection(hum.Died:Connect(function() removePlayerTarget(plr) end))
	end
end

local function watchPlayer(plr)
	if plr == localPlayer then return end
	trackConnection(plr.CharacterAdded:Connect(function(c)
		task.wait(0.5)
		if not settings.unloaded then addPlayerTarget(plr, c) end
	end))
	local c = plr.Character
	if c then task.spawn(function() task.wait(0.5); addPlayerTarget(plr, c) end) end
end

local function scanPlayers()
	if settings.unloaded then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local c = plr.Character
			if c and not playerTargets[plr] then pcall(addPlayerTarget, plr, c) end
		end
	end
end

