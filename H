----------------------------------------------------------------
-- Silent Aim
----------------------------------------------------------------
local silentAimHooked   = false
local originalGetMuzzle = nil
local hookedInvModule   = nil

local aimRayParams = RaycastParams.new()
aimRayParams.FilterType = Enum.RaycastFilterType.Exclude
aimRayParams.IgnoreWater = true

local function getTargetAimPart(data)
	return settings.aimPart == "Head" and data.head or data.root
end

local function isTargetOccluded(model, pos)
	local dir = pos - camera.CFrame.Position
	local result = Workspace:Raycast(camera.CFrame.Position, dir, aimRayParams)
	if result and result.Instance and not result.Instance:IsDescendantOf(model) then
		local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
		if hitModel and hitModel.Name == "Male" then return false end
		return true
	end
	return false
end

local function updateAimTarget()
	if not settings.silentAim or settings.unloaded then
		selectedAimPart, selectedAimPosition, selectedTargetOccluded, selectedTargetKey = nil,nil,false,nil
		return
	end

	local ignoreList = {camera}
	local char = localPlayer.Character
	if char then tableInsert(ignoreList, char) end
	if excludedMaleModel then tableInsert(ignoreList, excludedMaleModel) end
	local tool = getEquippedTool()
	if tool then tableInsert(ignoreList, tool) end
	aimRayParams.FilterDescendantsInstances = ignoreList

	local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
	local bestVisPart, bestVisKey, bestVisPos, bestVisDist = nil,nil,nil, settings.fovRadius
	local bestOccPart, bestOccKey, bestOccPos, bestOccDist = nil,nil,nil, settings.fovRadius

	for key, data in pairs(getActiveTargets()) do
		local model = settings.mode == "PVP" and data.char or key
		if model then
			local part = getTargetAimPart(data)
			if part and part.Parent then
				local ok, vp, onScreen = pcall(function()
					return camera:WorldToViewportPoint(part.Position)
				end)
				if ok and onScreen then
					local dist = (Vector2.new(vp.X, vp.Y) - center).Magnitude
					if dist < settings.fovRadius then
						local occ = isTargetOccluded(model, part.Position)
						if not occ then
							if dist < bestVisDist then
								bestVisPart, bestVisKey, bestVisPos, bestVisDist = part, key, part.Position, dist
							end
						elseif settings.wallbang then
							if dist < bestOccDist then
								bestOccPart, bestOccKey, bestOccPos, bestOccDist = part, key, part.Position, dist
							end
						end
					end
				end
			end
		end
	end

	if bestVisPart then
		selectedAimPart, selectedAimPosition, selectedTargetOccluded, selectedTargetKey =
			bestVisPart, bestVisPos, false, bestVisKey
	elseif bestOccPart then
		selectedAimPart, selectedAimPosition, selectedTargetOccluded, selectedTargetKey =
			bestOccPart, bestOccPos, true, bestOccKey
	else
		selectedAimPart, selectedAimPosition, selectedTargetOccluded, selectedTargetKey = nil,nil,false,nil
	end
	lastAimUpdate = clockNow()
end

local function installSilentAimHook()
	if silentAimHooked then return true end
	local scr = findNilModule("FirearmInventory")
	if not scr then return false end
	local ok, mod = pcall(require, scr)
	if not ok or not mod or not mod.GetMuzzleCFrame then return false end

	hookedInvModule   = mod
	originalGetMuzzle = mod.GetMuzzleCFrame
	local saved = originalGetMuzzle

	mod.GetMuzzleCFrame = function(self, ...)
		local callOk, cf = pcall(saved, self, ...)
		if not callOk or not cf then return saved(self, ...) end

		if clockNow() - lastAimUpdate > aimUpdateInterval or (selectedAimPart and not selectedAimPart.Parent) then
			updateAimTarget()
		end

		if selectedAimPart and selectedAimPart.Parent then
			local targetPos
			pcall(function() targetPos = selectedAimPart.Position end)
			targetPos = targetPos or selectedAimPosition
			if not targetPos then return cf end

			if settings.aimPart == "Head" then
				targetPos = targetPos + Vector3.new(0,0.1,0)
			end

			local muzzlePos = cf.Position
			if settings.wallbang and selectedTargetOccluded then
				local dir = targetPos - muzzlePos
				local d = dir.Magnitude
				if d > 1 then muzzlePos = muzzlePos + dir.Unit * (d - 0.5) end
			end
			return CFrame.lookAt(muzzlePos, targetPos)
		end
		return cf
	end

	silentAimHooked = true
	return true
end

local function removeSilentAimHook()
	if hookedInvModule and originalGetMuzzle then
		pcall(function() hookedInvModule.GetMuzzleCFrame = originalGetMuzzle end)
	end
	silentAimHooked, originalGetMuzzle, hookedInvModule = false, nil, nil
	selectedAimPart, selectedAimPosition, selectedTargetOccluded, selectedTargetKey = nil,nil,false,nil
end

