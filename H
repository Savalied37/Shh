local excludedMaleModel = nil

local function refreshExcludedModel()
	excludedMaleModel = nil
	pcall(function()
		local container = Workspace:FindFirstChild("Model")
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Model") and child.Name == "Male" then
					excludedMaleModel = child
					break
				end
			end
		end
	end)
	return excludedMaleModel
end

local function isExcludedModel(m)
	if not m then return false end
	if excludedMaleModel and m == excludedMaleModel then return true end
	return false
end

