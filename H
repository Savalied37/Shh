----------------------------------------------------------------
-- NPC target management
----------------------------------------------------------------
local removeNpcTarget, addNpcTarget, retryNpcRegistration

function retryNpcRegistration(npc, count)
	if settings.unloaded or npcTargets[npc] then return end
	if not npc or not npc.Parent then return end
	count = count or 0
	if count > 6 then return end
	local ok, valid = pcall(isValidNpc, npc)
	if ok and valid then
		addNpcTarget(npc)
	elseif npc.Parent then
		task.delay(0.5, function() retryNpcRegistration(npc, count + 1) end)
	end
end

function addNpcTarget(npc)
	if settings.unloaded or npcTargets[npc] or not npc.Parent then return end
	if not isValidNpc(npc) then return end
	local root, head = findNpcRoot(npc), findNpcHead(npc)
	if not root or not head then return end
	local hum = npc:FindFirstChildOfClass("Humanoid")
	local data = { root = root, head = head, hum = hum, conn = nil, ancestryConn = nil }
	npcTargets[npc] = data

	if settings.wallEsp and settings.mode == "PVE" then
		attachTargetEsp(npc, data)
	end

	if hum then
		data.conn = trackConnection(hum.Died:Connect(function() removeNpcTarget(npc) end))
	end

	local ancConn
	ancConn = trackConnection(npc.AncestryChanged:Connect(function(_, newParent)
		if newParent == nil then
			if ancConn then pcall(function() ancConn:Disconnect() end) end
			removeNpcTarget(npc)
		end
	end))
	data.ancestryConn = ancConn
end

function removeNpcTarget(npc)
	if not npc then return end
	local data = npcTargets[npc]
	npcTargets[npc] = nil
	if data then
		removeTargetEsp(data)
		if data.conn then pcall(function() data.conn:Disconnect() end) end
		if data.ancestryConn then pcall(function() data.ancestryConn:Disconnect() end) end
		if selectedAimPart and (selectedAimPart == data.head or selectedAimPart == data.root) then
			selectedAimPart = nil
		end
	end
end

local function scanNpcs()
	if settings.unloaded then return end
	refreshExcludedModel()
	for npc in pairs(npcTargets) do
		if npc == excludedMaleModel then removeNpcTarget(npc) end
	end
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Model") and desc.Name == "Male" and not npcTargets[desc] then
			local ok, valid = pcall(isValidNpc, desc)
			if ok and valid then pcall(addNpcTarget, desc) end
		end
	end
end

