local function updateEspVisibility(camPos)
	local parts = {}
	for part, box in pairs(headBoxes) do
		if part and part.Parent and box and box.Parent then
			tableInsert(parts, part)
		else
			headBoxes[part] = nil
			headOwners[part] = nil
		end
	end
	local count = #parts
	if count == 0 then return end
	if espCursor > count then espCursor = 1 end

	espRayParams.FilterDescendantsInstances = buildEspIgnoreList()

	for _ = 1, mathMin(espBatchSize, count) do
		local part = parts[espCursor]
		espCursor += 1
		if espCursor > count then espCursor = 1 end

		local box = headBoxes[part]
		if part and box then
			local owner = headOwners[part]
			local dir = part.Position - camPos
			if dir.Magnitude > 5 then
				local ok, result = pcall(function()
					return Workspace:Raycast(camPos, dir, espRayParams)
				end)
				local visible = true
				if ok and result and result.Instance then
					if owner and owner.Parent then
						visible = result.Instance == part or result.Instance:IsDescendantOf(owner)
					else
						visible = result.Instance == part
					end
					if not visible then
						local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
						if hitModel and hitModel.Name == "Male" then visible = true end
					end
				end
				local col = visible and visibleColor or occludedColor
				box.Color3 = col
				local tag = distanceTags[part]
				if tag and tag.Parent then
					local tl = tag:FindFirstChildOfClass("TextLabel")
					if tl then
						tl.Text = mathFloor(dir.Magnitude + 0.5) .. "m"
						tl.TextColor3 = col
					end
				end
			end
		end
	end
end

